{
  "name": "@zwantum/blog-storage",
  "version": "1.0.0",
  "description": "Storage abstraction and adapters for ZwantumBlog",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@zwantum/blog-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  }
}
